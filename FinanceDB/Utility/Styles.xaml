<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DeciCash"  TargetType="DataGridCell">
        <Setter Property="TextBlock.Text">
            <Setter.Value>
                <Binding Path=""
                         StringFormat="{}{2:######}$}"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DeciPercent"  TargetType="DataGridCell">
        <Setter Property="TextBlock.Text">
            <Setter.Value>
                <Binding Path=""
                         StringFormat="{}{0:######}%}"/>
            </Setter.Value>
        </Setter>
    </Style>



</ResourceDictionary>