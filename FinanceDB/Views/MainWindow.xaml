<Window x:Class="FinanceDB.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinanceDB.Views"
        xmlns:vm="clr-namespace:FinanceDB.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="Window_Loaded">
    
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
        <Grid>
        <StackPanel Margin="10">
            <TextBox TextChanged="Query_Search" Margin="0,5,0,5"/>
            <Button Margin="0,5" Content="Refresh" Command="{Binding SearchCommand}"/>
            <Label Content="placeholder"/>
            <DataGrid ItemsSource="{Binding Funds}"
                    Name="dgItems"
                    AlternatingRowBackground="PaleVioletRed"
                    AutoGenerateColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ticker" Binding="{Binding Ticker}"/>
                    <DataGridTextColumn Header="Share" Binding="{Binding Share}" CellStyle="{StaticResource DeciCash}" />
                    <DataGridTextColumn Header="Per Share" Binding="{Binding PerShare}" CellStyle="{StaticResource DeciCash}" />
                    <DataGridTextColumn Header="Dist. Yield" Binding="{Binding DistYield, StringFormat={}{:######}$}" />
                    <DataGridTextColumn Header="Add Total" Binding="{Binding AddTotal}" CellStyle="{StaticResource DeciCash}" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Total}" CellStyle="{StaticResource DeciCash}" />
                    <DataGridTextColumn Header="Yr. Dividend" Binding="{Binding YrDividend}" CellStyle="{StaticResource DeciCash}" />
                    <DataGridTextColumn Header="Per div." Binding="{Binding PerDiv}" CellStyle="{StaticResource DeciCash}" />
                    <DataGridTextColumn Header="Exp. Ratio" Binding="{Binding ExpRatio}" CellStyle="{StaticResource DeciCash}" />
                    <DataGridTextColumn Header="Add Yr. Div" Binding="{Binding AddYrDiv}" CellStyle="{StaticResource DeciCash}" />
                    <DataGridTextColumn Header="Tot. Yr. Div" Binding="{Binding TotYrDiv}" CellStyle="{StaticResource DeciCash}" />
                    <DataGridTextColumn Header="T. Ratio" Binding="{Binding TRatio}" CellStyle="{StaticResource DeciCash}" />
                    <DataGridTextColumn Header="Ratio" Binding="{Binding Ratio}" CellStyle="{StaticResource DeciCash}" />
                    <DataGridTextColumn Header="T. Rat. Diff" Binding="{Binding TRatDiff}" CellStyle="{StaticResource DeciCash}" />
                    <DataGridTextColumn Header="Div. Freq" Binding="{Binding DivFreq}" CellStyle="{StaticResource DeciCash}" />
                    <DataGridTextColumn Header="Desc" Binding="{Binding Desc}" CellStyle="{StaticResource DeciCash}" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Window>
